# ==============================================================
# CodePulse Server Configuration
# ==============================================================

# Server Port
PORT=5000

# Client URL (for CORS in production)
CLIENT_URL=http://localhost:5173

# GitHub Personal Access Token (Optional but Recommended)
# Without a token, GitHub REST API allows 60 requests per hour per IP.
# With a token (classic or fine-grained with `public_repo` scope), limit increases to 5,000 requests/hr.
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Groq API Key (Optional but Recommended for Live AI Suggestions)
# If not provided, CodePulse will automatically generate intelligent rule-based recommendations.
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Groq Model (Defaults to llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Cache TTL in milliseconds (default: 15 minutes = 900000)
CACHE_TTL_MS=900000
